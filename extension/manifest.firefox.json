{
  "manifest_version": 2,
  "name": "leaf browser capture",
  "short_name": "leaf",
  "description": "Hands the downloads you start in the browser to the leaf file manager on this computer.",
  "version": "1.0.0",
  "icons": { "16": "icons/leaf-16.png", "32": "icons/leaf-32.png", "48": "icons/leaf-48.png", "128": "icons/leaf-128.png" },
  "background": { "scripts": ["background.js"] },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["downloads", "nativeMessaging", "storage", "webRequest", "http://*/*", "https://*/*"],
  "browser_specific_settings": { "gecko": { "id": "browser-capture@leaf-filemanager", "strict_min_version": "115.0" } }
}
